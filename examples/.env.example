# filepath: examples/.env.example
# Copy to ./.env and fill in your values.
#
# Required: R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_ENDPOINT, R2_BUCKET.
# Optional vars have defaults (see docs/README.md).

# ---- Cloudflare R2 Account ----
R2_ACCOUNT_ID="your_account_id_here"
R2_ACCESS_KEY_ID="your_r2_access_key"
R2_SECRET_ACCESS_KEY="your_r2_secret_key"
R2_ENDPOINT="https://your_account_id.r2.cloudflarestorage.com"
R2_BUCKET="my-backups"

# ---- Upload Behaviour ----
R2_REGION="auto"                       # R2 accepts "auto"
R2_STORAGE_CLASS="STANDARD"           # STANDARD | INFREQUENT_ACCESS
R2_PATH_PREFIX="backups/$(hostname)/" # key prefix; supports $(date), $(hostname)
R2_OVERWRITE="false"                  # true|false — fail if key exists
R2_MULTIPART_THRESHOLD="64MB"
R2_MULTIPART_CHUNKSIZE="32MB"

# ---- Source (upload only) ----
SOURCE_PATH="/var/backups"            # file OR directory (each file uploaded as separate object)
ARCHIVE_AFTER_UPLOAD="true"          # move uploaded files to archive folder after success
SOURCE_ARCHIVE_DIR="/var/backups/.archive"  # required when ARCHIVE_AFTER_UPLOAD=true
SOURCE_ARCHIVE_ORGANIZE="$(date)"     # subdir under archive; e.g. 2026-09-29
                                       # supports $(hostname), $(date)

# ---- Download Behaviour ----
DOWNLOAD_DEST="./downloads/"          # local destination directory
DOWNLOAD_OVERWRITE="false"            # true|false
DOWNLOAD_PATTERN="*"                  # glob filter; e.g. "*.sql.gz"
DOWNLOAD_DELETE_REMOTE="false"        # delete from R2 after download (DR rotation)

# ---- Safety ----
DRY_RUN="false"                       # true = show what would happen, no I/O
REQUIRE_CONFIRM="true"                # prompt before each operation
RETRY_COUNT="3"
RETRY_DELAY="5"                       # seconds

# ---- Logging ----
LOG_LEVEL="info"                      # debug|info|warn|error
LOG_FILE="r2.log"                           # empty = stderr only

# ---- Email Notifications (requires msmtp; sender comes from ~/.msmtprc) ----
EMAIL_ENABLED="false"                 # master switch; -e/--email forces true
EMAIL_TO=""                           # comma-separated recipients; e.g. ops@example.com,oncall@example.com
EMAIL_SUBJECT_OK="[R2] Upload OK: $(hostname) at $(date)"
EMAIL_SUBJECT_FAIL="[R2] Upload FAILED: $(hostname) at $(date)"
EMAIL_ON_SUCCESS="true"               # notify on successful run
EMAIL_ON_FAILURE="true"               # notify on failed run
MSMTP_ACCOUNT="default"               # account name from ~/.msmtprc
